# Internal API Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Worker Pool Configuration
WORKER_MAX_CONCURRENCY=4
DOWNLOAD_TEMP_DIR=./downloads/temp

# System Output Directories
# MP3 files default to %USERPROFILE%/Music/app_music
# MP4 files default to %USERPROFILE%/Videos/app_videos
DOWNLOAD_MUSIC_DIR=
DOWNLOAD_VIDEOS_DIR=

# Security / Internal Secret
INTERNAL_API_KEY=local_internal_secret_key_12345
