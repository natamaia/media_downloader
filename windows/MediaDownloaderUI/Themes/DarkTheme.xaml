    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#181818"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#333333"/>
    
