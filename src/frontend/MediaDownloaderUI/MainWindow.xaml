<Window x:Class="MediaDownloaderUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:MediaDownloaderUI.Components"
        Title="MediaDownloader Pro" Height="680" Width="980"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#181818" Foreground="#F3F4F6">

    <Window.Resources>
        <!-- VS Code Style Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Minimalist Footer Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MAIN WINDOW SCROLLVIEWER -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">

                <!-- COMPONENT 1: URL INPUT CARD -->
                <components:UrlInputControl x:Name="UrlInputCard"
                                            AnalyzeRequested="UrlInputCard_AnalyzeRequested"/>

                <!-- COMPONENT 2: MEDIA PREVIEW CARD -->
                <components:MediaPreviewControl x:Name="PreviewCard" Visibility="Collapsed"/>

                <!-- COMPONENT 3: COMPACT DOWNLOAD WORKERS QUEUE CARD -->
                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- Card Title Bar -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Fila de Downloads e Workers" FontSize="15" FontWeight="Bold" Foreground="#F3F4F6"/>
                            <TextBlock x:Name="TxtWorkerCount" Text="0 Workers Ativos" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Compact Internal ScrollViewer (MaxHeight 300 to prevent card stretching) -->
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <ItemsControl x:Name="LstDownloads">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Row 1: Title, Provider, Status Badge -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Provider}" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#F3F4F6"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Quality}" FontSize="11" Foreground="#9CA3AF" Margin="0,0,10,0"/>
                                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Row 2: Emerald Progress Bar -->
                                                    <ProgressBar Grid.Row="1" Height="6" Value="{Binding ProgressPercent}" Maximum="100" Background="#252526" Foreground="#10B981" Margin="0,0,0,6"/>

                                                    <!-- Row 3: Speed, ETA, Action Buttons -->
                                                    <Grid Grid.Row="2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Progresso: " FontSize="11" Foreground="#9CA3AF"/>
                                                            <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#F3F4F6" Margin="0,0,12,0"/>
                                                            <TextBlock Text="Velocidade: " FontSize="11" Foreground="#9CA3AF"/>
                                                            <TextBlock Text="{Binding DownloadSpeed}" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,0,12,0"/>
                                                            <TextBlock Text="ETA: " FontSize="11" Foreground="#9CA3AF"/>
                                                            <TextBlock Text="{Binding EtaSeconds, StringFormat='{}{0}s'}" FontSize="11" Foreground="#F3F4F6"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="Abrir Pasta" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Tag="{Binding FilePath}" Click="BtnOpenFolder_Click"/>
                                                            <Button Content="Cancelar" Style="{StaticResource SecondaryBtn}" Tag="{Binding DownloadId}" Click="BtnCancel_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="TxtEmptyList" Text="Nenhum download ativo no momento." FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,16"/>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- MINIMALIST FOOTER STATUS BAR -->
        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#252526" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DotStatus" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatusBackend" Text="MediaDownloader Pro v1.0.0 | API Interna On-line" FontSize="11" Foreground="#9CA3AF"/>
                </StackPanel>
                <TextBlock Text="Windows 10 / 11 Native" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
