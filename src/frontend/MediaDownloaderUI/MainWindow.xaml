<Window x:Class="MediaDownloaderUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaDownloader Pro - Windows 10/11 Native" Height="720" Width="1080"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Rounded Button Style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Status Footer Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR (Cabeçalho Estilo Tailwind Dark) -->
        <Border Grid.Row="0" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="#6366F1" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MediaDownloader Pro" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Orquestrador de Workers Descentralizado" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Saved Folders Quick Info Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="20" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎵 Música: " FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtMusicPath" Text="Music\app_music" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="20" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎬 Vídeo: " FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtVideoPath" Text="Videos\app_videos" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Backend Status Badge -->
                <Border Grid.Column="2" x:Name="BadgeBackendStatus" Background="#064E3B" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatusBackend" Text="API Interna On-line" FontSize="12" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT CONTAINER -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">

                <!-- CARD 1: INPUT DE URL E SELEÇÃO DE FORMATO/QUALIDADE -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Novo Download" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtUrl" FontSize="14" Padding="14,12" Background="#0F172A" Foreground="#F8FAFC"
                                     BorderBrush="#334155" BorderThickness="1"
                                     Text="Cole aqui o link (YouTube, Spotify, Instagram, Deezer, etc)..."/>

                            <Button Grid.Column="1" Content="Analisar Link" Style="{StaticResource SecondaryBtn}" Margin="12,0,0,0"
                                    Click="BtnAnalyze_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Format Selector -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Formato:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,10,0"/>
                                <RadioButton x:Name="RbMp4" Content="MP4 (Vídeo)" IsChecked="True" Foreground="#F8FAFC" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Format_Checked"/>
                                <RadioButton x:Name="RbMp3" Content="MP3 (Áudio)" Foreground="#F8FAFC" VerticalAlignment="Center" Checked="Format_Checked"/>
                            </StackPanel>

                            <!-- Quality Selector -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Qualidade:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CmbQuality" Width="140" Background="#0F172A" SelectedIndex="0">
                                    <ComboBoxItem Content="1080p (FHD)"/>
                                    <ComboBoxItem Content="720p (HD)"/>
                                    <ComboBoxItem Content="480p (SD)"/>
                                    <ComboBoxItem Content="360p"/>
                                    <ComboBoxItem Content="MP3 320k (Alta)"/>
                                    <ComboBoxItem Content="MP3 192k (Média)"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Download Location Info Indicator -->
                            <TextBlock Grid.Column="2" x:Name="TxtCurrentTargetDir" Text="Pasta destino: Videos\app_videos" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>

                            <!-- Start Download Button -->
                            <Button Grid.Column="3" Content="⚡ Iniciar Download" Style="{StaticResource PrimaryBtn}" Click="BtnStartDownload_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: PREVIEW DO LINK ANALISADO (Fica oculta até clicar em Analisar) -->
                <Border x:Name="CardPreview" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail Image -->
                        <Border Grid.Column="0" Width="120" Height="70" Background="#0F172A" CornerRadius="8" Margin="0,0,16,0" ClipToBounds="True">
                            <Image x:Name="ImgThumbnail" Stretch="UniformToFill"/>
                        </Border>

                        <!-- Video Metadata -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border x:Name="BadgeProvider" Background="#4F46E5" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtProviderName" Text="YouTube" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock x:Name="TxtPreviewTitle" Text="Título do Vídeo Extraído" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtPreviewDuration" Text="Duração: 03:45 | Qualidades disponíveis: 1080p, 720p, 480p" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 3: LISTA DE DOWNLOADS / WORKERS ATIVOS -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Fila de Downloads e Workers" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="TxtWorkerCount" Text="0 Workers Ativos" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Download Items ItemsControl -->
                        <ItemsControl x:Name="LstDownloads">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 1: Title, Format, Status Badge -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#6366F1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Provider}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Quality}" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Progress Bar -->
                                            <ProgressBar Grid.Row="1" Height="8" Value="{Binding ProgressPercent}" Maximum="100" Background="#1E293B" Foreground="#6366F1" Margin="0,0,0,8"/>

                                            <!-- Row 3: Speed, ETA, Action Buttons -->
                                            <Grid Grid.Row="2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Progresso: " FontSize="11" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,14,0"/>
                                                    <TextBlock Text="Velocidade: " FontSize="11" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding DownloadSpeed}" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,14,0"/>
                                                    <TextBlock Text="ETA: " FontSize="11" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding EtaSeconds, StringFormat='{}{0}s'}" FontSize="11" Foreground="#F8FAFC"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="Abrir Pasta" Style="{StaticResource SecondaryBtn}" Padding="8,4" Margin="0,0,8,0" Tag="{Binding FilePath}" Click="BtnOpenFolder_Click"/>
                                                    <Button Content="Cancelar" Style="{StaticResource SecondaryBtn}" Padding="8,4" Tag="{Binding DownloadId}" Click="BtnCancel_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TxtEmptyList" Text="Nenhum download ativo no momento. Cole um link acima para iniciar." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,20"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER BAR -->
        <Border Grid.Row="2" Background="#090D16" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <TextBlock Text="MediaDownloader Pro v1.0.0 | Arquitetura com Workers Descentralizados" FontSize="11" Foreground="#64748B"/>
                <TextBlock Text="Compatível com Windows 10 e Windows 11" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
