<Window x:Class="MediaDownloaderUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:MediaDownloaderUI.Components"
        Title="MediaDownloader Pro" Height="700" Width="1000"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" StateChanged="Window_StateChanged"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Custom 4px Ultra-Thin Minimalist ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource EmeraldAccentBrush}" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- System Caption Button Style (Minimize, Maximize/Restore) -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- System Close Button Style -->
        <Style x:Key="CloseCaptionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Button Style -->
        <Style x:Key="DeleteBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DeleteBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DeleteTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ROOT CONTAINER GRID -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Custom Themed Title Bar (34px) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main App Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CUSTOM THEMED TITLE BAR -->
        <Grid Grid.Row="0" Height="34" Background="{DynamicResource CardBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Logo & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="⚡" FontSize="13" Foreground="{DynamicResource EmeraldAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="MediaDownloader Pro" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- System Caption Buttons (Minimize, Maximize, Close) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize" Style="{StaticResource CaptionBtn}" Content="─" Click="BtnMinimize_Click" ToolTip="Minimizar"/>
                <Button x:Name="BtnMaximize" Style="{StaticResource CaptionBtn}" Content="🗖" Click="BtnMaximize_Click" ToolTip="Maximizar"/>
                <Button x:Name="BtnClose" Style="{StaticResource CloseCaptionBtn}" Content="✕" Click="BtnClose_Click" ToolTip="Fechar"/>
            </StackPanel>
        </Grid>

        <!-- MAIN APP CONTENT GRID -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <!-- Row 0: URL Input & Analyzed Preview (Auto Height) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Parent Queue Container Card (Expands fluidly) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP SECTION: URL INPUT & PREVIEW CARD -->
            <StackPanel Grid.Row="0">
                <!-- COMPONENT 1: URL INPUT CARD -->
                <components:UrlInputControl x:Name="UrlInputCard"
                                            AnalyzeRequested="UrlInputCard_AnalyzeRequested"/>

                <!-- COMPONENT 2: MEDIA PREVIEW CARD -->
                <components:MediaPreviewControl x:Name="PreviewCard" Visibility="Collapsed"/>
            </StackPanel>

            <!-- PARENT QUEUE CONTAINER CARD -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Queue Card Title Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Inner Scrollable Container -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Queue Card Title Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Fila de Downloads e Workers" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtWorkerCount" Text="0 Workers Ativos" FontSize="11" Foreground="{DynamicResource EmeraldAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="🗑️ Limpar Downloads" Style="{StaticResource SecondaryBtn}" Padding="10,4" Click="BtnClearDownloads_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- INNER FLUID SMOOTH SCROLLVIEWER FOR DOWNLOAD CARDS -->
                    <components:SmoothScrollViewer Grid.Row="1" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl x:Name="LstDownloads">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,10" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform Y="0"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Border.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="-8" To="0" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Row 0: Title, Provider, Status Badge -->
                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Provider}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BadgeTextBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Quality}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding DisplayStatus}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColorBrush}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Row 1: Optional Error Message / Notice -->
                                                <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" FontSize="11" Foreground="{Binding StatusColorBrush}" Margin="0,0,0,6" Visibility="{Binding ErrorMessageVisibility}" TextWrapping="Wrap"/>

                                                <!-- Row 2: Smooth Emerald Progress Bar -->
                                                <components:SmoothProgressBar Grid.Row="2" Height="6" SmoothValue="{Binding ProgressPercent}" Maximum="100" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource EmeraldAccentBrush}" Margin="0,0,0,6"/>

                                                <!-- Row 3: Speed, ETA, Action Buttons -->
                                                <Grid Grid.Row="3">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Progresso: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="Velocidade: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding DownloadSpeed}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource EmeraldAccentBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="ETA: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding EtaSeconds, StringFormat='{}{0}s'}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>

                                                    <!-- Action Buttons: Abrir Pasta e Apagar -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="Abrir Pasta" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Tag="{Binding FilePath}" IsEnabled="{Binding IsNotDeleted}" Click="BtnOpenFolder_Click"/>
                                                        <Button Content="{Binding DeleteButtonText}" Style="{StaticResource DeleteBtn}" Tag="{Binding DownloadId}" IsEnabled="{Binding IsNotDeleted}" Click="BtnDelete_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TxtEmptyList" Text="Nenhum download ativo no momento." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30"/>
                        </Grid>
                    </components:SmoothScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
