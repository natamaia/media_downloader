<Window x:Class="MediaDownloaderUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:MediaDownloaderUI.Components"
        Title="MediaDownloader Pro - Windows 10/11 Native" Height="720" Width="1080"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Component 1: Top Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Scrollable Body -->
            <RowDefinition Height="*"/>
            <!-- Footer Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- COMPONENT 1: HEADER BAR -->
        <components:HeaderBarControl Grid.Row="0" x:Name="HeaderControl"/>

        <!-- MAIN SCROLLABLE CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">

                <!-- COMPONENT 2: URL INPUT CARD -->
                <components:UrlInputControl x:Name="UrlInputCard"
                                            AnalyzeRequested="UrlInputCard_AnalyzeRequested"/>

                <!-- COMPONENT 3: MEDIA PREVIEW CARD -->
                <components:MediaPreviewControl x:Name="PreviewCard" Visibility="Collapsed"/>

                <!-- COMPONENT 4: DOWNLOAD WORKERS QUEUE CARD -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Fila de Downloads e Workers" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="TxtWorkerCount" Text="0 Workers Ativos" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Download Items DataTemplate -->
                        <ItemsControl x:Name="LstDownloads">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 1: Title, Format, Status Badge -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#6366F1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Provider}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Quality}" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Progress Bar -->
                                            <ProgressBar Grid.Row="1" Height="8" Value="{Binding ProgressPercent}" Maximum="100" Background="#1E293B" Foreground="#6366F1" Margin="0,0,0,8"/>

                                            <!-- Row 3: Speed, ETA, Action Buttons -->
                                            <Grid Grid.Row="2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Progresso: " FontSize="11" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,14,0"/>
                                                    <TextBlock Text="Velocidade: " FontSize="11" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding DownloadSpeed}" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,14,0"/>
                                                    <TextBlock Text="ETA: " FontSize="11" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding EtaSeconds, StringFormat='{}{0}s'}" FontSize="11" Foreground="#F8FAFC"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="Abrir Pasta" Style="{StaticResource SecondaryBtn}" Padding="8,4" Margin="0,0,8,0" Tag="{Binding FilePath}" Click="BtnOpenFolder_Click"/>
                                                    <Button Content="Cancelar" Style="{StaticResource SecondaryBtn}" Padding="8,4" Tag="{Binding DownloadId}" Click="BtnCancel_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TxtEmptyList" Text="Nenhum download ativo no momento. Cole um link acima para iniciar." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,20"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER BAR -->
        <Border Grid.Row="2" Background="#090D16" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <TextBlock Text="MediaDownloader Pro v1.0.0 | Arquitetura com Workers Descentralizados" FontSize="11" Foreground="#64748B"/>
                <TextBlock Text="Compatível com Windows 10 e Windows 11" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
