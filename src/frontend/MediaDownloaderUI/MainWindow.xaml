<Window x:Class="MediaDownloaderUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:MediaDownloaderUI.Components"
        Title="MediaDownloader Pro" Height="700" Width="1000"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#181818" Foreground="#F3F4F6">

    <Window.Resources>
        <!-- Custom 4px Ultra-Thin Minimalist ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.Thumb>
                                    <Thumb Background="#10B981" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS Code Style Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Button Style -->
        <Style x:Key="DeleteBtn" TargetType="Button">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="Foreground" Value="#FECACA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- MAIN APP GRID: NO FOOTER, NO WINDOW SCROLLBAR, FULL RESPONSIVE FIT -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Row 0: URL Input & Analyzed Preview (Auto Height) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Parent Queue Container Card (Expands fluidly to fill window height) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP SECTION: URL INPUT & PREVIEW CARD -->
        <StackPanel Grid.Row="0">
            <!-- COMPONENT 1: URL INPUT CARD -->
            <components:UrlInputControl x:Name="UrlInputCard"
                                        AnalyzeRequested="UrlInputCard_AnalyzeRequested"/>

            <!-- COMPONENT 2: MEDIA PREVIEW CARD -->
            <components:MediaPreviewControl x:Name="PreviewCard" Visibility="Collapsed"/>
        </StackPanel>

        <!-- PARENT QUEUE CONTAINER CARD (Expands fluidly without forcing a window scrollbar) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Queue Card Title Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Inner Scrollable Container -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Queue Card Title Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Fila de Downloads e Workers" FontSize="15" FontWeight="Bold" Foreground="#F3F4F6"/>
                    <TextBlock x:Name="TxtWorkerCount" Text="0 Workers Ativos" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- INNER FLUID SCROLLVIEWER FOR DOWNLOAD CARDS (Custom 6px Emerald ScrollBar) -->
                <ScrollViewer Grid.Row="1" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl x:Name="LstDownloads">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 1: Title, Provider, Status Badge -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Provider}" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#F3F4F6"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Quality}" FontSize="11" Foreground="#9CA3AF" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Emerald Progress Bar -->
                                            <ProgressBar Grid.Row="1" Height="6" Value="{Binding ProgressPercent}" Maximum="100" Background="#252526" Foreground="#10B981" Margin="0,0,0,6"/>

                                            <!-- Row 3: Speed, ETA, Action Buttons -->
                                            <Grid Grid.Row="2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Progresso: " FontSize="11" Foreground="#9CA3AF"/>
                                                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#F3F4F6" Margin="0,0,12,0"/>
                                                    <TextBlock Text="Velocidade: " FontSize="11" Foreground="#9CA3AF"/>
                                                    <TextBlock Text="{Binding DownloadSpeed}" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,0,12,0"/>
                                                    <TextBlock Text="ETA: " FontSize="11" Foreground="#9CA3AF"/>
                                                    <TextBlock Text="{Binding EtaSeconds, StringFormat='{}{0}s'}" FontSize="11" Foreground="#F3F4F6"/>
                                                </StackPanel>

                                                <!-- Action Buttons: Abrir Pasta e Apagar -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="Abrir Pasta" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Tag="{Binding FilePath}" Click="BtnOpenFolder_Click"/>
                                                    <Button Content="Apagar" Style="{StaticResource DeleteBtn}" Tag="{Binding DownloadId}" Click="BtnDelete_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TxtEmptyList" Text="Nenhum download ativo no momento." FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
