<UserControl x:Class="MediaDownloaderUI.Components.UrlInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- VS Code Style Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Emerald Primary Button Style -->
        <Style x:Key="EmeraldBtn" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#042F2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="MediaDownloader Pro" FontSize="15" FontWeight="Bold" Foreground="#F3F4F6"/>
                <TextBlock Text="Copie e cole o link para baixar vídeo ou áudio" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtUrl" FontSize="13" Padding="12,10" Background="#1E1E1E" Foreground="#F3F4F6"
                         BorderBrush="#333333" BorderThickness="1"
                         Text="Cole aqui o link (YouTube, Spotify, Instagram, Deezer, etc)..." GotFocus="TxtUrl_GotFocus"/>

                <Button Grid.Column="1" Content="🔍 Analisar Link" Style="{StaticResource EmeraldBtn}" Margin="10,0,0,0"
                        Click="BtnAnalyze_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
