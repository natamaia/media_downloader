<UserControl x:Class="MediaDownloaderUI.Components.UrlInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Novo Download" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>
            
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtUrl" FontSize="14" Padding="14,12" Background="#0F172A" Foreground="#F8FAFC"
                         BorderBrush="#334155" BorderThickness="1"
                         Text="Cole aqui o link (YouTube, Spotify, Instagram, Deezer, etc)..."/>

                <Button Grid.Column="1" Content="Analisar Link" Style="{StaticResource SecondaryBtn}" Margin="12,0,0,0"
                        Click="BtnAnalyze_Click"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Format Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Formato:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,10,0"/>
                    <RadioButton x:Name="RbMp4" Content="MP4 (Vídeo)" IsChecked="True" Foreground="#F8FAFC" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Format_Checked"/>
                    <RadioButton x:Name="RbMp3" Content="MP3 (Áudio)" Foreground="#F8FAFC" VerticalAlignment="Center" Checked="Format_Checked"/>
                </StackPanel>

                <!-- Quality Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Qualidade:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbQuality" Width="140" Background="#0F172A" SelectedIndex="0">
                        <ComboBoxItem Content="1080p (FHD)"/>
                        <ComboBoxItem Content="720p (HD)"/>
                        <ComboBoxItem Content="480p (SD)"/>
                        <ComboBoxItem Content="360p"/>
                        <ComboBoxItem Content="MP3 320k (Alta)"/>
                        <ComboBoxItem Content="MP3 192k (Média)"/>
                    </ComboBox>
                </StackPanel>

                <!-- Target Folder Info -->
                <TextBlock Grid.Column="2" x:Name="TxtCurrentTargetDir" Text="Pasta destino: Videos\app_videos" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>

                <!-- Start Download Button -->
                <Button Grid.Column="3" Content="⚡ Iniciar Download" Style="{StaticResource PrimaryBtn}" Click="BtnStartDownload_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
