<UserControl x:Class="MediaDownloaderUI.Components.MediaPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thumbnail Image -->
            <Border Grid.Column="0" Width="120" Height="70" Background="#0F172A" CornerRadius="8" Margin="0,0,16,0" ClipToBounds="True">
                <Image x:Name="ImgThumbnail" Stretch="UniformToFill"/>
            </Border>

            <!-- Metadata Info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border x:Name="BadgeProvider" Background="#4F46E5" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtProviderName" Text="YouTube" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="TxtPreviewTitle" Text="Título da Mídia Extraída" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                </StackPanel>
                <TextBlock x:Name="TxtPreviewDetails" Text="Duração: 03:45 | Formatos disponíveis: 1080p, 720p, 480p" FontSize="12" Foreground="#94A3B8"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
