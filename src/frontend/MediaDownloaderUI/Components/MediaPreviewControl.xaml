<UserControl x:Class="MediaDownloaderUI.Components.MediaPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Dynamic Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Dynamic Emerald Button Style -->
        <Style x:Key="EmeraldBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource EmeraldAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource EmeraldAccentTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic ComboBoxItem Style -->
        <Style x:Key="AdaptiveComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Row: Thumbnail + Info + Download Button -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Thumbnail Image -->
                <Border Grid.Column="0" Width="130" Height="75" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Margin="0,0,14,0" ClipToBounds="True">
                    <Image x:Name="ImgThumbnail" Stretch="UniformToFill"/>
                </Border>

                <!-- Title & Provider Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border x:Name="BadgeProvider" Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtProviderName" Text="YouTube" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BadgeTextBrush}"/>
                        </Border>
                        <TextBlock x:Name="TxtPreviewTitle" Text="Título da Mídia Extraída" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtPreviewDetails" Text="Duração: 03:45 | Qualidades encontradas: 1080p, 720p, 480p" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Emerald Download Button Inside Preview Card -->
                <Button Grid.Column="2" x:Name="BtnStartDownload" Content="⚡ Baixar Mídia Agora" Style="{StaticResource EmeraldBtn}" VerticalAlignment="Center" Margin="14,0,0,0" Click="BtnStartDownload_Click"/>
            </Grid>

            <!-- Bottom Row: Format & Quality Selectors Inside Preview Card -->
            <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Format Selector -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Formato:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" FontSize="12"/>
                        <RadioButton x:Name="RbMp4" Content="MP4 (Vídeo)" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Format_Checked"/>
                        <RadioButton x:Name="RbMp3" Content="MP3 (Áudio)" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Checked="Format_Checked"/>
                    </StackPanel>

                    <!-- Quality Selector -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Qualidade:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" FontSize="12"/>
                        <ComboBox x:Name="CmbQuality" Width="140" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" SelectedIndex="0">
                            <ComboBoxItem Content="1080p (FHD)" Style="{StaticResource AdaptiveComboBoxItem}"/>
                            <ComboBoxItem Content="720p (HD)" Style="{StaticResource AdaptiveComboBoxItem}"/>
                            <ComboBoxItem Content="480p (SD)" Style="{StaticResource AdaptiveComboBoxItem}"/>
                            <ComboBoxItem Content="360p" Style="{StaticResource AdaptiveComboBoxItem}"/>
                            <ComboBoxItem Content="MP3 320k (Alta)" Style="{StaticResource AdaptiveComboBoxItem}"/>
                            <ComboBoxItem Content="MP3 192k (Média)" Style="{StaticResource AdaptiveComboBoxItem}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Target Folder Info -->
                    <TextBlock Grid.Column="2" x:Name="TxtCurrentTargetDir" Text="Pasta destino: Videos\app_videos" FontSize="11" Foreground="{DynamicResource EmeraldAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
